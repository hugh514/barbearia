NODE_ENV=development
PORT=3000
APP_NAME="Barber API"
DATABASE_URL="postgresql://barber:barber@localhost:5432/barber_db?schema=public"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

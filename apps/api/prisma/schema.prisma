generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users         User[]
  customers     Customer[]
  conversations Conversation[]
  messages      Message[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  name         String
  email        String
  passwordHash String   @map("password_hash")
  role         UserRole @default(BARBEIRO)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  assignedConversations Conversation[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

enum UserRole {
  ADMIN
  GERENTE
  BARBEIRO
  CLIENTE
}

model Customer {
  id            String         @id @default(uuid())
  tenantId      String         @map("tenant_id")
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  name          String
  phone         String
  instagramId   String?        @map("instagram_id")
  instagramUser String?        @map("instagram_user")
  origin        CustomerOrigin @default(MANUAL)
  planStatus    PlanStatus     @default(NONE)
  lastVisit     DateTime?      @map("last_visit")
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  conversations Conversation[]

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@index([tenantId, phone])
  @@index([tenantId, name])
  @@map("customers")
}

model Conversation {
  id         String              @id @default(uuid())
  tenantId   String              @map("tenant_id")
  tenant     Tenant              @relation(fields: [tenantId], references: [id])
  customerId String              @map("customer_id")
  customer   Customer            @relation(fields: [customerId], references: [id])
  channel    ConversationChannel
  status     ConversationStatus  @default(ABERTA)
  assignedTo String?             @map("assigned_to")
  assignedUser User?             @relation(fields: [assignedTo], references: [id])
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")

  messages Message[]

  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@map("conversations")
}

model Message {
  id             String              @id @default(uuid())
  tenantId       String              @map("tenant_id")
  tenant         Tenant              @relation(fields: [tenantId], references: [id])
  conversationId String              @map("conversation_id")
  conversation   Conversation        @relation(fields: [conversationId], references: [id])
  content        String
  direction      MessageDirection
  channel        ConversationChannel
  externalId     String?             @map("external_id")
  createdAt      DateTime            @default(now()) @map("created_at")

  @@index([conversationId])
  @@index([tenantId])
  @@map("messages")
}

enum ConversationChannel {
  WHATSAPP
  INSTAGRAM
}

enum ConversationStatus {
  ABERTA
  AGUARDANDO
  EM_ATENDIMENTO
  FECHADA
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum CustomerOrigin {
  MANUAL
  WHATSAPP
  INSTAGRAM
}

enum PlanStatus {
  NONE
  ACTIVE
  PENDING
  OVERDUE
  CANCELLED
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users         User[]
  customers     Customer[]
  conversations Conversation[]
  messages      Message[]
  appointments  Appointment[]
  plans         Plan[]
  subscriptions Subscription[]
  payments      Payment[]
  channelConfig ChannelConfig?

  @@map("tenants")
}

model ChannelConfig {
  id               String   @id @default(uuid())
  tenantId         String   @unique @map("tenant_id")
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  businessName     String   @map("business_name")
  services         Json     @default("[]")
  address          String
  phone            String
  workingHours     String   @map("working_hours")
  rules            String?
  whatsappInstance String?  @map("whatsapp_instance")
  instagramPageId  String?  @map("instagram_page_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("channel_configs")
}

model User {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  name         String
  email        String
  passwordHash String   @map("password_hash")
  role         UserRole @default(BARBEIRO)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  customerId            String?  @map("customer_id")
  customer              Customer? @relation(fields: [customerId], references: [id])
  assignedConversations Conversation[]
  appointments          Appointment[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

enum UserRole {
  ADMIN
  GERENTE
  BARBEIRO
  CLIENTE
}

model Customer {
  id            String         @id @default(uuid())
  tenantId      String         @map("tenant_id")
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  name          String
  phone         String
  instagramId   String?        @map("instagram_id")
  instagramUser String?        @map("instagram_user")
  origin        CustomerOrigin @default(MANUAL)
  planStatus    PlanStatus     @default(NONE)
  lastVisit     DateTime?      @map("last_visit")
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  conversations Conversation[]
  appointments  Appointment[]
  subscriptions Subscription[]
  payments      Payment[]
  linkedUsers   User[]

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@index([tenantId, phone])
  @@index([tenantId, name])
  @@map("customers")
}

model Conversation {
  id         String              @id @default(uuid())
  tenantId   String              @map("tenant_id")
  tenant     Tenant              @relation(fields: [tenantId], references: [id])
  customerId String              @map("customer_id")
  customer   Customer            @relation(fields: [customerId], references: [id])
  channel    ConversationChannel
  status     ConversationStatus  @default(ABERTA)
  assignedTo String?             @map("assigned_to")
  assignedUser User?             @relation(fields: [assignedTo], references: [id])
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")
  deletedAt  DateTime?           @map("deleted_at")

  messages Message[]

  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@map("conversations")
}

model Message {
  id             String              @id @default(uuid())
  tenantId       String              @map("tenant_id")
  tenant         Tenant              @relation(fields: [tenantId], references: [id])
  conversationId String              @map("conversation_id")
  conversation   Conversation        @relation(fields: [conversationId], references: [id])
  content        String
  direction      MessageDirection
  channel        ConversationChannel
  externalId     String?             @map("external_id")
  createdAt      DateTime            @default(now()) @map("created_at")
  deletedAt      DateTime?           @map("deleted_at")

  @@index([conversationId])
  @@index([tenantId])
  @@map("messages")
}

enum ConversationChannel {
  WHATSAPP
  INSTAGRAM
}

enum ConversationStatus {
  ABERTA
  AGUARDANDO
  EM_ATENDIMENTO
  FECHADA
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum CustomerOrigin {
  MANUAL
  WHATSAPP
  INSTAGRAM
}

enum PlanStatus {
  NONE
  ACTIVE
  PENDING
  OVERDUE
  CANCELLED
}

model Appointment {
  id           String            @id @default(uuid())
  tenantId     String            @map("tenant_id")
  tenant       Tenant            @relation(fields: [tenantId], references: [id])
  customerId   String            @map("customer_id")
  customer     Customer          @relation(fields: [customerId], references: [id])
  barberId     String?           @map("barber_id")
  barber       User?             @relation(fields: [barberId], references: [id])
  status       AppointmentStatus @default(AGUARDANDO)
  services     String[]
  totalPrice   Decimal?          @map("total_price") @db.Decimal(10, 2)
  notes        String?
  cancelReason String?           @map("cancel_reason")
  startedAt    DateTime?         @map("started_at")
  finishedAt   DateTime?         @map("finished_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  deletedAt    DateTime?         @map("deleted_at")

  @@index([tenantId, status])
  @@index([tenantId, barberId])
  @@index([tenantId, customerId])
  @@index([tenantId, createdAt])
  @@map("appointments")
}

enum AppointmentStatus {
  AGUARDANDO
  EM_ATENDIMENTO
  FINALIZADO
  CANCELADO
}

model Plan {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  name         String
  description  String?
  priceCents   Int      @map("price_cents")
  intervalDays Int      @default(30) @map("interval_days")
  benefits     String[]
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@index([tenantId])
  @@map("plans")
}

model Subscription {
  id            String             @id @default(uuid())
  tenantId      String             @map("tenant_id")
  tenant        Tenant             @relation(fields: [tenantId], references: [id])
  customerId    String             @map("customer_id")
  customer      Customer           @relation(fields: [customerId], references: [id])
  planId        String             @map("plan_id")
  plan          Plan               @relation(fields: [planId], references: [id])
  status        SubscriptionStatus @default(PENDENTE)
  startedAt     DateTime?          @map("started_at")
  nextBillingAt DateTime?          @map("next_billing_at")
  cancelledAt   DateTime?          @map("cancelled_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  deletedAt     DateTime?          @map("deleted_at")

  payments Payment[]

  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@map("subscriptions")
}

enum SubscriptionStatus {
  PENDENTE
  ATIVO
  SUSPENSO
  CANCELADO
}

model Payment {
  id             String        @id @default(uuid())
  tenantId       String        @map("tenant_id")
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  subscriptionId String        @map("subscription_id")
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id])
  customerId     String        @map("customer_id")
  customer       Customer      @relation(fields: [customerId], references: [id])
  externalId     String?       @unique @map("external_id")
  method         PaymentMethod
  amountCents    Int           @map("amount_cents")
  status         PaymentStatus @default(PENDENTE)
  paymentUrl     String?       @map("payment_url")
  qrCode         String?       @map("qr_code")
  gatewayData    Json?         @map("gateway_data")
  paidAt         DateTime?     @map("paid_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  @@index([tenantId, status])
  @@index([tenantId, subscriptionId])
  @@index([tenantId, customerId])
  @@index([externalId])
  @@map("payments")
}

enum PaymentMethod {
  PIX
  CARD
  BOLETO
}

enum PaymentStatus {
  PENDENTE
  APROVADO
  RECUSADO
  EXPIRADO
  REEMBOLSADO
}

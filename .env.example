# Valores só para desenvolvimento local. Nenhum é segredo real.
# Copie para .env antes de subir: cp .env.example .env

# Portas no seu computador
API_PORT=3000
PAINEL_PORT=3001
CLIENTE_PORT=3002
POSTGRES_PORT=5433
REDIS_HOST_PORT=6379

# Banco (usuário e senha do Postgres do docker compose)
POSTGRES_USER=barber
POSTGRES_PASSWORD=barber
POSTGRES_DB=barber_db

# API
APP_NAME="Barber API"
SWAGGER_ENABLED=true
JWT_SECRET=dev-jwt-secret-change-in-production-min-32-chars!!
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-refresh-secret-change-production-32-chars!!
JWT_REFRESH_EXPIRES_IN=7d
INTERNAL_API_KEY=dev-internal-api-key-change-in-production
# Fronts (painel e cliente): cookie de sessão Secure em produção. O docker-compose.yml
# já passa COOKIE_SECURE=false para os dois, porque o compose roda em http. Só o valor
# 'false' desliga; fora disso vale o padrão. Nunca use false com https.
# COOKIE_SECURE=false
# Painel e cliente: repassam o IP de quem chamou à API em X-Forwarded-For (limite de
# tentativas por pessoa). Só ligue com um proxy na frente que sobrescreva esse
# cabeçalho e TRUST_PROXY na API; sem proxy, o IP é forjável e o limite deixa de
# valer. O docker-compose.yml não repassa esta variável aos fronts.
# FORWARD_CLIENT_IP=false

# Se mudar PAINEL_PORT ou CLIENTE_PORT, ajuste aqui também (CORS e Socket.IO).
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002,http://127.0.0.1:3001,http://127.0.0.1:3002
SENTRY_DSN=

# Mercado Pago: token falso de teste. Gerar cobrança PIX só funciona com um
# token de sandbox seu (TEST-...). Sem ele, nada é cobrado de ninguém.
MERCADO_PAGO_ACCESS_TOKEN=TEST-dev-mercado-pago-access-token
MERCADO_PAGO_WEBHOOK_SECRET=dev-mp-webhook-secret
MERCADO_PAGO_NOTIFICATION_URL=

# WhatsApp (Evolution API), Instagram e IA: vazios deixam tudo desligado.
# Sem EVOLUTION_API_KEY os webhooks do WhatsApp são recusados.
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
INSTAGRAM_VERIFY_TOKEN=dev-instagram-verify-token
INSTAGRAM_APP_SECRET=dev-instagram-app-secret
INSTAGRAM_PAGE_ACCESS_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
